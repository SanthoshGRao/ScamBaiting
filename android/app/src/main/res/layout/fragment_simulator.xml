<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/primary_10"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary_30"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/simulator_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/primary" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/simulator_title"
                    style="@style/ScamShield.SectionTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/simulator_desc"
                    android:textColor="@color/text_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSessionInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reason_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="0 msgs"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvSimRoundProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_reason_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="Round 3 / 10"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Scenario chips -->
    <HorizontalScrollView
        android:id="@+id/scrollScenarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupScenario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLottery"
                style="@style/ScamShield.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/scenario_lottery" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOtp"
                style="@style/ScamShield.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scenario_otp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInvestment"
                style="@style/ScamShield.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scenario_investment" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTech"
                style="@style/ScamShield.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scenario_tech" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDelivery"
                style="@style/ScamShield.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scenario_delivery" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Persona + typing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sim_persona_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_persona"
            app:tint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/simulator_persona_label"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvSimPersona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Confused Uncle"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layoutTypingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_typing_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvTypingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/typing_indicator"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutTypingDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotTyping1"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_typing_dot" />

                <View
                    android:id="@+id/dotTyping2"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_typing_dot" />

                <View
                    android:id="@+id/dotTyping3"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_typing_dot" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Same pref as Settings → Max replies (mid-session tweaks) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_sim_persona_bar"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sim_ai_replies_slider"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSimRepliesValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="10" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSimReplies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="10"
            android:valueFrom="1"
            android:valueTo="20"
            app:haloColor="@color/primary_10"
            app:thumbColor="@color/primary"
            app:trackColorActive="@color/primary"
            app:trackColorInactive="@color/slider_track" />
    </LinearLayout>

    <!-- Chat surface -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChatWindow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="14dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/surface_bg"
        app:cardElevation="3dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Simulator.ChatWindow"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sim_chat_inner">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChatMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="72dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueSim"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="@string/sim_continue"
                android:textAllCaps="false"
                android:visibility="gone"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutEmptyChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="36dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/card_highlight"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/choose_scenario"
                        android:padding="22dp"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/text_hint" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/choose_scenario"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/simulator_empty_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom actions -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="@color/surface_bg"
        app:cardElevation="10dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Simulator.BottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartSim"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:text="@string/start_simulation"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopSim"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:enabled="false"
                android:minWidth="120dp"
                android:text="@string/end_simulation"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/risk_high"
                app:strokeWidth="1.5dp"
                android:textColor="@color/risk_high" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
