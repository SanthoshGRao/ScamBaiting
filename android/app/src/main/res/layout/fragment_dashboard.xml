<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dashboardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:layoutAnimation="@anim/layout_staggered_slide_up"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Dashboard header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/card_spacing">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_shield"
                app:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_dashboard"
                    style="@style/ScamShield.SectionTitle" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stay safe. We've got your back."
                    android:textSize="12sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutNotificationAccessIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvNotificationStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reason_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="OFFLINE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Security hero card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@animator/scale_press"
            android:clickable="true"
            android:focusable="true"
            style="@style/ScamShield.Card.Hero"
            app:cardBackgroundColor="@color/transparent"
            android:layout_marginBottom="@dimen/card_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card_glass"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <com.scamshield.app.ui.widget.SecurityMonitorView
                    android:id="@+id/securityMonitor"
                    android:layout_width="@dimen/security_ring_size"
                    android:layout_height="@dimen/security_ring_size" />

                <LinearLayout
                    android:id="@+id/layoutProtectionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatusHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTECTION STATUS"
                        android:textColor="@color/primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_reason_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/protection_inactive"
                        style="@style/ScamShield.CardTitle" />

                    <TextView
                        android:id="@+id/tvStatusDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:text="Enable notification access to begin protection"
                        style="@style/ScamShield.Caption" />
                        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToggleProtection"
                        style="@style/ScamShield.Button.Gradient"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_btn_protection_active"
                        android:stateListAnimator="@animator/scale_press_protection_button"
                        android:text="@string/grant_access"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_shield"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:rippleColor="#1FFFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Security Overview"
                style="@style/ScamShield.CardTitle" />
                
            <TextView
                android:id="@+id/tvViewDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reason_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="View Details >"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/card_spacing"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatScanned"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:stateListAnimator="@animator/scale_press"
                android:clickable="true"
                android:focusable="true"
                style="@style/ScamShield.Card.Stat">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_blue"
                    android:minHeight="138dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_persona_icon_plate"
                        android:backgroundTint="#203B82F6"
                        android:padding="7dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvScannedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Messages\nScanned"
                        android:lines="2"
                        style="@style/ScamShield.Caption" />
                        
                    <ProgressBar
                        android:id="@+id/pbStatScanned"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progress="0"
                        android:progressTint="@color/primary"
                        android:progressBackgroundTint="@color/divider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatThreats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:stateListAnimator="@animator/scale_press"
                android:clickable="true"
                android:focusable="true"
                style="@style/ScamShield.Card.Stat">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_cyan"
                    android:minHeight="138dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/ivThreatIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_persona_icon_plate"
                        android:backgroundTint="#2000BFFF"
                        android:padding="7dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/primary_light" />

                    <TextView
                        android:id="@+id/tvThreatsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Threats\nBlocked"
                        android:lines="2"
                        style="@style/ScamShield.Caption" />
                        
                    <ProgressBar
                        android:id="@+id/pbStatThreats"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progress="0"
                        android:progressTint="@color/primary_light"
                        android:progressBackgroundTint="@color/divider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatBaited"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:stateListAnimator="@animator/scale_press"
                android:clickable="true"
                android:focusable="true"
                style="@style/ScamShield.Card.Stat">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_stat_card_purple"
                    android:minHeight="138dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_persona_icon_plate"
                        android:backgroundTint="#208B5CF6"
                        android:padding="7dp"
                        android:src="@drawable/ic_persona"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tvBaitedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="Scam\nBaits"
                        android:lines="2"
                        style="@style/ScamShield.Caption" />
                        
                    <ProgressBar
                        android:id="@+id/pbStatBaited"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:progressBackgroundTint="@color/divider" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Quick test -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ScamShield.Card"
            android:layout_marginBottom="@dimen/card_spacing">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_quick_test_panel"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">
                    
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_persona_icon_plate"
                        android:backgroundTint="#208B5CF6"
                        android:padding="8dp"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/accent" />
                        
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Test"
                            style="@style/ScamShield.CardTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paste suspicious SMS, WhatsApp,\nor email text for instant analysis."
                            android:textSize="12sp"
                            style="@style/ScamShield.Caption" />
                    </LinearLayout>
                    
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ScamShield.TextInput"
                    android:hint="Paste a suspicious message...">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTestMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="5"
                        android:minLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyze"
                    style="@style/ScamShield.Button.Gradient"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_btn_analyze_premium"
                    android:stateListAnimator="@animator/scale_press_protection_button"
                    android:text="Analyze Message"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_search"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:rippleColor="#1FFFFFFF" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ScamShield.Card.Compact"
                    app:cardBackgroundColor="@color/card_highlight"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvResultBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_high"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="HIGH RISK"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/tvResultConfBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_reason_chip"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvResultTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvResultCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_reason_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvResultSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExplainToggle"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            android:text="Why is this a scam?"
                            android:textAllCaps="false"
                            android:textColor="@color/primary"
                            android:visibility="gone"
                            app:icon="@drawable/ic_info"
                            app:iconGravity="textStart"
                            app:iconTint="@color/primary" />

                        <LinearLayout
                            android:id="@+id/layoutExplainPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvExplainScores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupReasons"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:visibility="gone"
                                app:chipSpacingVertical="4dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvResultRules"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent activity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/text_hint"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Recent Activity"
                style="@style/ScamShield.CardTitle" />
                
            <TextView
                android:id="@+id/tvViewAllActivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_reason_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="View All >"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecentActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/ScamShield.Card.Compact"
            android:layout_marginBottom="@dimen/card_spacing">

            <LinearLayout
                android:id="@+id/layoutRecentActivityContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/ivRecentActivityShield"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_persona_icon_plate"
                    android:backgroundTint="#203B82F6"
                    android:padding="16dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're protected.\nNo threats detected yet."
                    android:textAlignment="center"
                    style="@style/ScamShield.Caption" />

                <LinearLayout
                    android:id="@+id/layoutRecentRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
