<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/card_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="16dp">

    <LinearLayout
        android:id="@+id/layoutOverlayBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/risk_high_bg"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivOverlayIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/risk_high"
                android:contentDescription="Warning Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scam Detected"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/risk_high" />

                <TextView
                    android:id="@+id/tvOverlayPackage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Message"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint" />
            </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseOverlay"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOverlayMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suspicious link detected in message from unknown sender. High confidence (92%)."
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayIgnore"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ignore"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:strokeColor="@color/text_secondary"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlayBait"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Auto-Reply"
                android:textSize="12sp"
                android:textAllCaps="false"
                app:backgroundTint="@color/primary"
                android:textColor="@color/text_primary"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
