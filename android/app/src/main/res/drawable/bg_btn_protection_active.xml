<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1FFFFFFF">
    <item>
        <layer-list>
            <item android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <solid android:color="#33030A16" />
                </shape>
            </item>

            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#FF0F4C81"
                        android:centerColor="#FF1B6CA8"
                        android:endColor="#FF3A8DDE"
                        android:type="linear" />
                </shape>
            </item>

            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#22FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#26FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
