<resources>
    <style name="ScamShield" />

    <style name="Theme.ScamShield" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/card_highlight</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="android:colorControlHighlight">@color/primary_30</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowAnimationStyle">@style/ScamShieldWindowAnim</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="sliderStyle">@style/ScamShield.Slider</item>
        <item name="materialSwitchStyle">@style/ScamShield.Switch</item>
        <item name="chipStyle">@style/ScamShield.Chip</item>
        <item name="materialButtonStyle">@style/ScamShield.Button.Filled</item>
        <item name="materialCardViewStyle">@style/ScamShield.Card</item>
        <item name="bottomSheetDialogTheme">@style/ScamShield.BottomSheet</item>
        <item name="textInputStyle">@style/ScamShield.TextInput</item>
    </style>

    <style name="ScamShieldWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="ScamShield.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/slider_track</item>
        <item name="thumbColor">@color/primary</item>
        <item name="haloColor">@color/primary_30</item>
        <item name="trackHeight">8dp</item>
        <item name="thumbRadius">14dp</item>
        <item name="haloRadius">28dp</item>
        <item name="tickColorActive">@color/white</item>
        <item name="tickColorInactive">@color/divider</item>
        <item name="tickVisible">true</item>
    </style>

    <style name="ScamShield.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/white</item>
        <item name="trackTint">@color/switch_track_off</item>
        <item name="trackDecorationTint">@color/primary</item>
    </style>

    <style name="ScamShield.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/card_stroke</item>
        <item name="chipStrokeWidth">@dimen/card_stroke_width</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="checkedIconTint">@color/white</item>
        <item name="chipCornerRadius">12dp</item>
    </style>

    <style name="ScamShield.Chip.Selected" parent="ScamShield.Chip">
        <item name="chipBackgroundColor">@color/primary</item>
        <item name="chipStrokeColor">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="ScamShield.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="ScamShield.Card.Hero" parent="ScamShield.Card">
        <item name="cardBackgroundColor">@color/card_elevated</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="ScamShield.Card.Compact" parent="ScamShield.Card">
        <item name="cardCornerRadius">@dimen/card_radius_compact</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="ScamShield.Card.Stat" parent="ScamShield.Card">
        <item name="cardCornerRadius">@dimen/card_radius_compact</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="ScamShield.Card.Glass" parent="ScamShield.Card">
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="ScamShield.Button.Filled" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ScamShield.Button.Gradient" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_primary_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ScamShield.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/primary_10</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ScamShield.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/card_stroke</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ScamShield.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="hintTextColor">@color/text_hint</item>
    </style>

    <style name="ShapeAppearance.Simulator.ChatWindow" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.Simulator.BottomBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ScamShield.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ScamShield.BottomSheetStyle</item>
        <item name="android:colorBackground">@color/surface_bg</item>
    </style>

    <style name="ScamShield.BottomSheetStyle" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface_bg</item>
        <item name="shapeAppearance">@style/ScamShield.BottomSheetShape</item>
    </style>

    <style name="ScamShield.BottomSheetShape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ScamShield.SectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ScamShield.PageTitle">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="ScamShield.SectionTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ScamShield.CardTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="ScamShield.PageSubtitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="ScamShield.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="ScamShield.Badge.High" parent="">
        <item name="android:background">@drawable/bg_badge_high</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <style name="ScamShield.Bubble.Scammer" parent="">
        <item name="android:background">@drawable/bg_chat_scammer</item>
    </style>

    <style name="ScamShield.Bubble.AI" parent="">
        <item name="android:background">@drawable/bg_chat_ai</item>
    </style>
</resources>
