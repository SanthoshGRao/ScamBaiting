############################################
# ScamShield Backend - Environment Template
# Copy this file to .env and fill values.
############################################

# --- App ---
APP_NAME=ScamShield Detection API
APP_VERSION=2.0.0
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=sqlite:///./scamshield.db
# Example PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/scamshield

# --- Auth ---
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Bootstrap Admin ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:8000

# --- LLM (Shared) ---
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.78
LLM_TOP_P=0.9
LLM_MAX_TOKENS=220
LLM_HISTORY_TURNS=8

# --- Hybrid model routing ---
DETECTION_GROQ_MODEL=llama-3.1-8b-instant
DETECTION_OPENAI_FALLBACK_MODEL=gpt-4.1-mini
RESPONSE_OPENAI_HIGH_MODEL=gpt-4.1
RESPONSE_OPENAI_MEDIUM_MODEL=gpt-4.1-mini

# --- Detection Agent (prefix: DETECTION_) ---
DETECTION_DETECTION_THRESHOLD=0.65
DETECTION_HIGH_RISK_THRESHOLD=0.80
DETECTION_MEDIUM_RISK_THRESHOLD=0.50
DETECTION_LOW_RISK_THRESHOLD=0.30

DETECTION_RULE_WEIGHT=0.30
DETECTION_LLM_WEIGHT=0.70

DETECTION_LLM_PROVIDER=openai
DETECTION_LLM_MODEL=gpt-4.1-mini
DETECTION_LLM_TIMEOUT_SECONDS=5.0
DETECTION_LLM_MAX_RETRIES=1

DETECTION_PRIVACY_MODE=false
DETECTION_MAX_TEXT_LENGTH=5000
DETECTION_DEFAULT_LANGUAGE=en

# Optional override for categories config path
# DETECTION_CATEGORY_CONFIG_PATH=app/config/scam_categories.json
